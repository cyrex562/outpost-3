        "attribute": {
          "type": [
            "string",
            "null"
          ]
        },
        "mechanic": {
          "anyOf": [
            {
              "$ref": "#/definitions/RollMechanic"
            },
            {
              "type": "null"
            }
          ]
        },
        "skill": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Roller": {
      "description": "Who rolls in a contest (documentation + host targeting; the math is the same).",
      "type": "string",
      "enum": [
        "actor",
        "defender"
      ]
    },
    "SaveBonusProfile": {
      "description": "Save bonuses an item confers (mirrors `SaveBonusProfile`).",

      "enum": [
        "roll",
        "compute",
        "procedure",
        "format"
      ]
    },
    "RollMechanic": {
      "description": "The registered roll mechanics. New systems (GURPS roll-under, Savage exploding trait dice) are added here when their packs become real.",
      "oneOf": [
        {
          "description": "`2d6 + modifier ≥ tn`; XWN skill checks. No crit/fumble.",
          "type": "string",
          "enum": [
            "xwn2d6"
          ]
        },
        {
          "description": "`d20 + modifier ≥ tn`; nat 1 = fumble (always miss), nat 20 = crit (always hit).",
          "type": "string",
          "enum": [
            "xwn_d20_attack"
          ]
        },
        {
          "description": "`d20 + modifier ≥ tn`; XWN saving throws. No crit/fumble.",
          "type": "string",
          "enum": [
            "xwn_d20_save"
          ]
        }
      ]
    },
    "RollSpec": {
      "description": "What the roll draws on. `mechanic` defaults to the world's mechanic; `skill`/ `attribute` may be null (e.g. a save the defender rolls).",

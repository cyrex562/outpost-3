          "items": {
            "$ref": "#/definitions/Modifier"
          }
        },
        "requires_tag": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "StatusStacking": {
      "description": "How a re-application interacts with an existing status instance.",
      "type": "string",
      "enum": [
        "replace",
        "extend",
        "stack"
      ]
    },
    "TargetShape": {
      "description": "What an action targets.",
      "oneOf": [
        {
          "description": "The acting entity itself.",
          "type": "string",
          "enum": [
            "self"
          ]
        },
        {
          "description": "One other entity.",
          "type": "string",
          "enum": [
            "single"
          ]
        },
        {
          "description": "All entities within range of a point.",
          "type": "string",
          "enum": [
            "area"
          ]
        },
        {
          "description": "Entities along a line.",
          "type": "string",
          "enum": [
            "line"
          ]
        }
      ]
    },
    "Targeting": {
      "description": "An action's targeting spec.",
      "type": "object",
      "required": [
        "shape"
      ],
      "properties": {
        "range_band": {
          "type": [
            "string",
            "null"
          ]
        },
        "reach": {
          "description": "Extra cells of reach beyond the band's base (e.g. a polearm). Default 0.",
          "default": 0,
          "type": "integer",
          "format": "int64"
        },
        "requires_los": {
          "default": false,
          "type": "boolean"
        },
        "shape": {
          "$ref": "#/definitions/TargetShape"
        }
      }
    },
    "TnSource": {
      "description": "Where a contest's target number comes from. Externally tagged, matching the authoring surface (`{ defense: ac }`, `{ difficulty: 8 }`, …).",

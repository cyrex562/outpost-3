      "properties": {
        "evasion": {
          "default": 0,
          "type": "integer",
          "format": "int64"
        },
        "luck": {
          "default": 0,
          "type": "integer",
          "format": "int64"
        },
        "mental": {
          "default": 0,
          "type": "integer",
          "format": "int64"
        },
        "physical": {
          "default": 0,
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "SkillGoverns": {
      "description": "One action a skill governs: per-level modifiers, optionally gated by a tag.",

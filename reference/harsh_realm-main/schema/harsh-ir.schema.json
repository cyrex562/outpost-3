        {
          "description": "A fixed target number.",
          "type": "object",
          "required": [
            "static"
          ],
          "properties": {
            "static": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Resolved from a difficulty value/key.",
          "type": "object",
          "required": [
            "difficulty"
          ],
          "properties": {
            "difficulty": {
              "$ref": "#/definitions/DifficultyRef"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "The target's named defense value (e.g. `ac`).",
          "type": "object",
          "required": [
            "defense"
          ],
          "properties": {
            "defense": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "An opposed roll (a skill/expression the target rolls).",
          "type": "object",
          "required": [
            "opposed"
          ],
          "properties": {
            "opposed": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "A save DC the defender rolls against.",
          "type": "object",
          "required": [
            "effect_dc"
          ],
          "properties": {
            "effect_dc": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "TraitCost": {
      "description": "How acquiring a trait costs a character in a source system.",
      "type": "object",
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "points": {
          "default": 0,
          "type": "integer",
          "format": "int64"
        },
        "slot": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Trigger": {
      "description": "A declarative trigger: an event subscription with a condition and effects.\n\nMirrors `triggers/schema.py`. `when` is the *string* form of a condition expression (the R1 parser turns it into a [`super::condition::Expr`]); it defaults to `\"true\"` (always fires).",
      "type": "object",
      "required": [
        "id",
        "on"
      ],
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "do": {
          "description": "Effects to run when the trigger fires, in order.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/Effect"
          }
        },
        "id": {
          "description": "Unique within the owning record (trait/status/etc).",
          "type": "string"
        },
        "on": {
          "description": "Event type to subscribe to.",
          "type": "string"
        },
        "when": {
          "description": "Condition expression in string form. Default: `\"true\"`.",
          "default": "true",
          "type": "string"
        }
      }
    },
    "UseScope": {
      "description": "The scope over which a `uses` cap resets.",
      "type": "string",
      "enum": [
        "round",
        "scene",
        "day"
      ]
    },
    "Uses": {
      "description": "A cap on how many times an action may be used within a scope.",
      "type": "object",
      "required": [
        "n",
        "scope"
      ],
      "properties": {
        "n": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "scope": {
          "$ref": "#/definitions/UseScope"
        }
      }
    }
  }

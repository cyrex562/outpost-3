{
  "name": "outpost-3",
  "version": "0.3.5",
  "description": "Outpost 3: Wormhole Empire - UI Layer",
  "type": "module",
  "scripts": {
    "dev": "node_modules/.bin/vite",
    "build": "chmod +x node_modules/.bin/* && node_modules/.bin/vite build",
    "preview": "node_modules/.bin/vite preview",
    "watch": "node_modules/.bin/vite build --watch",
    "clean": "rm -f crates/outpost-server/static/css/main.css crates/outpost-server/static/js/main.js crates/outpost-server/static/js/main.js.map"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.24",
    "d3": "^7.9.0",
    "daisyui": "^5.5.18",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "alpinejs": "^3.13.0"
  }
}
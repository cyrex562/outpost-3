# Outpost 3 Configuration File
# Copy this file to config.toml and customize as needed
# All settings are optional; defaults will be used for any missing values

[server]
# Server host address (default: "127.0.0.1")
host = "127.0.0.1"
# Server port (default: 8081)
port = 8081

[database]
# SQLite database file path (default: "outpost3.db")
path = "outpost3.db"

[game]
# ============================================================================
# Legacy Settings (Pre-V5)
# ============================================================================

# Starting credits for new games (default: 10000)
starting_credits = 10000

# Turn duration in seconds - deprecated, use tick_rate_ms instead (default: 60)
turn_duration_seconds = 60

# ============================================================================
# V5 Time System Settings
# ============================================================================

# Milliseconds per game tick (default: 60000 = 1 minute real-time per tick)
# Each tick represents approximately 1 game hour
# Valid range: 1-3600000 (1ms to 1 hour)
tick_rate_ms = 60000

# Default speed multiplier on game start (default: 1)
# Valid values: 1 (normal), 2, 5, 10, etc.
default_speed_multiplier = 1

# Maximum allowed speed multiplier (default: 10)
# Players cannot set speed higher than this value
# Valid range: 1-100
max_speed_multiplier = 10

# ============================================================================
# V5 Idle Safety Settings
# ============================================================================

# Enable idle safety mode (default: true)
# When enabled, prevents catastrophic failures while player is away:
# - No colonist deaths from deprivation
# - Critical resource shortages trigger automatic rationing
# - Production stops gracefully when inputs exhausted (no damage)
# - Events requiring choices are queued for later
idle_safety_enabled = true

# Suppress auto-pause events when idle safety is enabled (default: true)
# When true, events that would normally pause the game are queued instead
suppress_autopause_in_idle_mode = true

# ============================================================================
# V5 Auto-Save Settings
# ============================================================================

# Auto-save interval in game ticks (default: 10 ticks = 10 game hours)
# Set to 0 to disable auto-save
# With default tick_rate_ms (60000), this auto-saves every 10 minutes real-time
auto_save_interval_ticks = 10

# Save directory path relative to game data directory (default: "saves")
save_directory = "saves"

# Maximum number of auto-save slots to keep (default: 5)
# Oldest auto-saves are deleted when this limit is reached
max_autosaves = 5

# Godot 4+ specific ignores
.godot/**
godot/.godot/**
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp
*.uid

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/**
data_*/
mono_crash.*.json

# .NET build output
**/bin/
**/obj/

# Rust/Cargo (kept in old/ — don't rebuild)
/target/
outpost_tauri/target/
outpost_tauri/gen/schemas/
xtask/target/
**/*.rs.bk

# outpost_web's file logging (tracing-appender, see main.rs) — local debug output only.
/logs/
*.pdb

# Node / frontend
node_modules/
dist/
# `frontend/package-lock.json` is deliberately NOT ignored. This rule was
# blanket-ignoring it, left over from the old web stack under `old/` — but the
# current frontend is an application, not a library, so its lockfile belongs in
# the repo: `npm ci` requires one, and without it CI resolves whatever
# transitive versions happen to be current on the day it runs (issue #457).
old/**/package-lock.json

# Coverage reports (generated, not committed)
coverage/

# Playwright (generated, not committed)
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Database files
*.db
*.db-shm
*.db-wal

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Environment
.env
.env.local
